# mesa-anyjev configuration (YAML form of .env.example). Load with `mesa-anyjev --config FILE`.
backend:
  kind: fake                       # fake | gateway | hf | composite
  gateway_base_url: http://127.0.0.1:8000
  gateway_api_key: null            # or MESA_LLM_API_KEY in the environment
  served_model: carc-fast
  tokenizer: RedHatAI/Qwen3-8B-NVFP4
  tokenizer_revision: e391349c110709b87bfc2ad2fde3f50dc5839fd8
  canonical_model: RedHatAI/Qwen3-8B-NVFP4
  hf_model: Qwen/Qwen3-8B
  hf_device: cuda
  hf_dtype: bfloat16
  hf_batch_size: 16
  logprobs: 20                     # always 20: the gateway drops allowed_token_ids (RESEARCH.md)
  max_choice_k: 8                  # raised only when the doctor measures zero label erasure
  workers: 8
  timeout: 120.0
decider:
  level: auto
  prior: batch
  adaptive_shifts: true
planner:
  kind: gateway                    # gateway | claude | static
  gateway_model: carc-tools
  claude_model: claude-opus-5
  claude_effort: high
  timeout: 600
policy:
  profile: prod                    # prod | dev
  defaults_file: policy_defaults.yaml
  hosted_providers: off            # off | allowlist
  hosted_allow_project_roots: []
  hosted_allow_local_sources: true
artifacts:
  dir: ~/.mesa/anyjev/artifacts
  strict: true
provenance:
  dsn: duckdb:///~/.mesa/anyjev/provenance.duckdb
ducklake:
  catalog_dsn: duckdb:///~/.mesa/anyjev/ducklake-catalog.duckdb
  cache_dir: ~/.mesa/anyjev/ducklake-cache
  local_project_root: /local/mesa-anyjev
  local_zone: local
ols:
  base_url: https://www.ebi.ac.uk/ols4/api/v2
  fixtures: off                    # off | record | replay
eval_root: null                    # or MESA_ANYJEV_EVAL_ROOT
