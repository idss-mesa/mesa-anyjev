# mesa-anyjev environment. Copy to .env (gitignored) and edit. The prefix MESA_ANYJEV_ plus a
# double underscore maps onto the nested config: MESA_ANYJEV_<section>__<field>=<value>.
# Precedence (highest wins): CLI flag > env var > YAML file > defaults.

# --- decision backend --------------------------------------------------------------------
# fake (tests, CI) | gateway (CARC LiteLLM -> vLLM on sparky-2, L0/L1) | hf (local weights,
# L0..L2, needs the `hf` extra and a GPU) | composite (gateway logprobs + local hidden states)
MESA_ANYJEV_BACKEND__KIND=fake
# The gateway is reached only over loopback. 127.0.0.1:8000 is the carc-litellm-tunnel user
# unit; 127.0.0.1:18000 is mesa-mcp's scripts/llm_tunnel.sh. No trailing /v1.
MESA_ANYJEV_BACKEND__GATEWAY_BASE_URL=http://127.0.0.1:8000
# LiteLLM master key. Never commit one. MESA_LLM_API_KEY (mesa-mcp's name) is honoured too.
MESA_ANYJEV_BACKEND__GATEWAY_API_KEY=
MESA_ANYJEV_BACKEND__SERVED_MODEL=carc-fast
# The served checkpoint; label token ids must match it exactly (RESEARCH.md).
MESA_ANYJEV_BACKEND__TOKENIZER=RedHatAI/Qwen3-8B-NVFP4
MESA_ANYJEV_BACKEND__TOKENIZER_REVISION=e391349c110709b87bfc2ad2fde3f50dc5839fd8
# Artifact slug. Stays the served repo id until the doctor records tokenizer parity (D5).
MESA_ANYJEV_BACKEND__CANONICAL_MODEL=RedHatAI/Qwen3-8B-NVFP4
MESA_ANYJEV_BACKEND__HF_MODEL=Qwen/Qwen3-8B
MESA_ANYJEV_BACKEND__MAX_CHOICE_K=8

# --- planner (the reasoning model) --------------------------------------------------------
# gateway (carc-tools, default when the gateway resolves) | claude | static (rule fallback)
MESA_ANYJEV_PLANNER__KIND=gateway
MESA_ANYJEV_PLANNER__GATEWAY_MODEL=carc-tools
MESA_ANYJEV_PLANNER__CLAUDE_MODEL=claude-opus-5

# --- write policy --------------------------------------------------------------------------
# prod: auto-writes need an AnyJev level >= L1 and a cited threshold; dev: L0 suffices.
MESA_ANYJEV_POLICY__PROFILE=prod
# off | allowlist. Hosted providers (MotherDuck prompt_jev) send metadata off this host.
MESA_ANYJEV_POLICY__HOSTED_PROVIDERS=off

# --- provenance sidecar and artifacts --------------------------------------------------------
MESA_ANYJEV_PROVENANCE__DSN=duckdb:///~/.mesa/anyjev/provenance.duckdb
MESA_ANYJEV_ARTIFACTS__DIR=~/.mesa/anyjev/artifacts

# --- mesa-ducklake (local mode for the CLI and tests) ----------------------------------------
MESA_ANYJEV_DUCKLAKE__CATALOG_DSN=duckdb:///~/.mesa/anyjev/ducklake-catalog.duckdb
MESA_ANYJEV_DUCKLAKE__CACHE_DIR=~/.mesa/anyjev/ducklake-cache

# --- bench and labels ----------------------------------------------------------------------------
# The neon-avu-eval checkout (cards, results/validated.json, results/metrics.json).
MESA_ANYJEV_EVAL_ROOT=/home/tswetnam/github/idss-mesa/neon-avu-eval

# --- opt-in test tiers ---------------------------------------------------------------------------
MESA_ANYJEV_LIVE=0
# MESA_ANYJEV_ENGINE=gateway
# MESA_ANYJEV_E2E=1
# MESA_ANYJEV_MOTHERDUCK=1
# MOTHERDUCK_TOKEN=
# MESA_ANYJEV_TEST_PG_HOST=127.0.0.1
